PROJECT_NAME := Compages
PROJECT_VERSION := 1.0.0
COMPILATION_MODE := debug
CXX_STANDARD := --std=c++20

###############################################################################
# Graphics backend to compile. The public gpu:: API never exposes any gl*
# symbol: switching this variable is the only thing needed to target another
# graphics API. Only GL45 is implemented for now, see doc/Philosophy.md for why.
#
# GPU_BACKEND_GL45: OpenGL 4.5 core profile with Direct State Access.
GPU_BACKEND ?= GL45
