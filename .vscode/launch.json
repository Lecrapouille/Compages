{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenGLExamples with gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/examples/build/OpenGLExamples",
            "args": [ "0" ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}
